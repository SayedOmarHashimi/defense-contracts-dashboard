# Absolute origin used for Open Graph and canonical URLs.
#
# Optional. Without it the build falls back to Vercel's own deployment host,
# and then to http://localhost:3000 for local builds. Set it once you know the
# production origin — especially if you attach a custom domain, since Vercel's
# generated host is not what you want in a shared link preview.
#
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
